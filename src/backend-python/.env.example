# VortexFlow Python worker - environment template.
# Copy this file to ".env" (which is gitignored) and fill in real values.
# Do NOT commit a populated .env. The values shown here are SHAPES, not secrets.

# AMQP connection string. In dev, point to the rabbitmq service from docker-compose.
# In prod, the password MUST come from a secret store (Vault / k8s Secret / SOPS).
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:5672/

# Redis connection string. Use 'rediss://' and a password in production.
REDIS_URL=redis://${REDIS_PASSWORD}@${REDIS_HOST}:6379/0

# HTTP fallback URL the worker uses to push ingested trends to the .NET API.
DOTNET_INGEST_URL=http://vortexflow-api:8080/api/trends/ingest

# Static API key expected by the .NET ingest endpoint. MUST be at least 16 chars.
# Generate with: openssl rand -base64 48
API_KEY_INTERNAL=

# Scrape cadence in minutes.
SCRAPING_INTERVAL_MINUTES=5

# OpenTelemetry collector endpoint (gRPC).
OTLP_ENDPOINT=http://otel-collector:4317

# Container/process hostname shown in logs.
HOSTNAME=vortexflow-worker

# Standard log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

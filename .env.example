# ============================================================================
# VortexFlow - local development secrets template.
# Copy to ".env" (gitignored) and fill in real values.
# Generate secrets with:    openssl rand -base64 48
# ============================================================================

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=vortexflow_db
POSTGRES_USER=vortexflow_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- RabbitMQ --------------------------------------------------------------
RABBITMQ_USER=vortexflow
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- .NET API / Worker shared secrets --------------------------------------
# JWT signing secret. MUST be >= 32 chars. Generate fresh per environment.
JWT_SECRET=CHANGE_ME_RANDOM_BASE64_AT_LEAST_32_CHARS
JWT_AUDIENCE=VortexFlowClient
JWT_ISSUER=VortexFlowApi

# Static internal API key used by the Python worker to call the .NET ingest
# endpoint. MUST be >= 32 chars.
API_KEY_INTERNAL=CHANGE_ME_RANDOM_BASE64_AT_LEAST_32_CHARS

# ---- Bootstrap admin (only used when BOOTSTRAP_SEED_ADMIN=true) ------------
BOOTSTRAP_SEED_ADMIN=true
BOOTSTRAP_ADMIN_EMAIL=admin@vortexflow.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_12_CHARS

# ---- Python worker ---------------------------------------------------------
SCRAPING_INTERVAL_MINUTES=5
OTLP_ENDPOINT=http://otel-collector:4317

# ---- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_API_URL=http://localhost:5032
VITE_WS_URL=http://localhost:5032/hub

# ---- Grafana (optional observability stack) -------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
